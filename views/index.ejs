<%- include('partials/head') %>
<%- include('partials/navbar') %>

<main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-10 flex flex-col justify-center">
  <!-- Tajuk Khusus Mode Cetak PDF -->
  <div class="print-only border-b-2 border-slate-800 pb-4 mb-6">
    <h1 class="font-serif text-2xl font-bold text-slate-900">Laporan Sintesis Literatur &amp; Rekomendasi Judul Penelitian</h1>
    <p class="text-xs text-slate-600 mt-1">Dihasilkan oleh Novellity &bull; Tanggal Cetak: <span id="print-date"></span></p>
  </div>

  <!-- ===================================================================== -->
  <!-- BAGIAN 1: KARTU UNGGAH JURNAL (Layout Gambar 2 + Gaya Visual Gambar 1) -->
  <!-- ===================================================================== -->
  <section id="upload-section" class="no-print max-w-4xl w-full mx-auto bg-white rounded-3xl border border-slate-200/90 shadow-xs p-6 sm:p-10 space-y-6">
    <div class="text-center space-y-1.5">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-[#111827] tracking-tight">Unggah Jurnal Ilmiah</h2>
      <p class="text-xs sm:text-sm text-slate-500">
        Temukan research gap dan rekomendasi judul penelitian dengan bantuan AI.
      </p>
    </div>

    <!-- Area Dropzone Bergaya Gambar 1 -->
    <div
      id="dropzone"
      tabindex="0"
      role="button"
      aria-label="Area unggah berkas PDF"
      class="border-2 border-dashed border-slate-300/90 hover:border-[#5B5CE6] focus:border-[#5B5CE6] rounded-2xl px-6 py-9 text-center transition bg-slate-50/40 hover:bg-indigo-50/20 cursor-pointer space-y-3.5"
    >
      <input
        type="file"
        id="file-input"
        accept=".pdf,application/pdf"
        multiple
        class="hidden"
      />

      <!-- Ikon Cloud Upload -->
      <div class="mx-auto w-12 h-12 rounded-2xl bg-indigo-50 text-[#5B5CE6] flex items-center justify-center">
        <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
          <path d="M12 13v6" />
          <path d="m9.5 15.5 2.5-2.5 2.5 2.5" />
        </svg>
      </div>

      <div class="space-y-1">
        <p class="text-base font-bold text-[#111827]">Drag &amp; Drop file PDF di sini</p>
        <p class="text-xs sm:text-sm text-slate-500">atau pilih file dari perangkat</p>
      </div>

      <div class="pt-0.5">
        <span class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold bg-[#111827] text-white shadow-2xs">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
          </svg>
          <span>Pilih File PDF</span>
        </span>
      </div>

      <p class="text-[11px] sm:text-xs text-slate-400 pt-1">
        PDF &bull; Maks. <%= maxFiles %> dokumen | Total ukuran: <%= maxTotalMb %> MB
      </p>
    </div>

    <!-- Peringatan Validasi Sisi Klien -->
    <div id="client-alert" class="hidden rounded-xl bg-rose-50 border border-rose-200 px-4 py-3 text-xs sm:text-sm text-rose-700"></div>

    <!-- Daftar Berkas Terpilih -->
    <div id="file-list-container" class="hidden space-y-2.5">
      <div class="flex items-center justify-between text-xs font-semibold text-slate-600">
        <span id="file-count-info">0 berkas dipilih</span>
        <div class="flex items-center gap-3">
          <span id="total-size-info">Total: 0 MB / <%= maxTotalMb %> MB</span>
          <button type="button" id="btn-clear-files" class="text-rose-600 hover:underline cursor-pointer">
            Hapus Semua
          </button>
        </div>
      </div>
      <ul id="file-list" class="divide-y divide-slate-100 border border-slate-200 rounded-xl bg-slate-50/60 overflow-hidden"></ul>
    </div>

    <!-- Tombol Memanjang Gunakan 3 Jurnal Contoh -->
    <button
      type="button"
      id="btn-sample"
      class="w-full flex items-center justify-between px-5 py-3.5 rounded-2xl border border-slate-200/90 bg-slate-50/70 hover:bg-slate-100/80 text-xs sm:text-sm font-semibold text-slate-800 transition cursor-pointer group"
    >
      <span class="w-4"></span>
      <span class="inline-flex items-center gap-2.5">
        <svg class="w-4 h-4 text-slate-600 group-hover:text-[#5B5CE6] transition" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
          <polyline points="14 2 14 8 20 8" />
          <line x1="16" y1="13" x2="8" y2="13" />
          <line x1="16" y1="17" x2="8" y2="17" />
        </svg>
        <span>Gunakan 3 Jurnal Contoh</span>
      </span>
      <span class="text-slate-400 group-hover:translate-x-0.5 transition">&rsaquo;</span>
    </button>

    <!-- Baris Persetujuan Privasi & Tombol Analisis Sekarang -->
    <div class="pt-1 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <label class="flex items-start sm:items-center gap-2.5 cursor-pointer select-none">
        <input
          type="checkbox"
          id="privacy-consent"
          class="mt-0.5 sm:mt-0 w-4 h-4 rounded border-slate-300 text-[#111827] focus:ring-indigo-500"
        />
        <span class="text-xs sm:text-sm text-slate-600">
          Saya menyetujui pemrosesan dokumen untuk analisis AI (tanpa disimpan di peladen).
        </span>
      </label>

      <button
        type="button"
        id="btn-analyze"
        disabled
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-xs sm:text-sm font-semibold bg-[#111827] text-white hover:bg-slate-800 disabled:bg-slate-200 disabled:text-slate-400 disabled:cursor-not-allowed transition shadow-2xs cursor-pointer shrink-0"
      >
        <span>Analisis Sekarang</span>
        <span aria-hidden="true">&rarr;</span>
      </button>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- BAGIAN 2: LAYAR PEMROSESAN AI (Layout Gambar 3 + Konten Gambar 4)      -->
  <!-- ===================================================================== -->
  <section id="loading-section" class="hidden no-print max-w-4xl w-full mx-auto bg-white rounded-3xl border border-slate-200/90 shadow-xs p-8 sm:p-12 text-center space-y-6">
    <!-- Ilustrasi Dokumen dengan Lengkung Berputar & Bintang -->
    <div class="mx-auto w-28 h-28 flex items-center justify-center relative">
      <div class="absolute inset-2 rounded-full bg-indigo-50/80"></div>
      <svg class="relative w-28 h-28" viewBox="0 0 120 120" fill="none">
        <!-- Lengkung Lingkaran Berputar -->
        <circle
          cx="60"
          cy="60"
          r="38"
          stroke="#6366F1"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-dasharray="95 145"
          class="animate-spin-arc"
        />
        <!-- Kartu Dokumen Tengah -->
        <rect x="38" y="32" width="44" height="56" rx="8" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="1.8" />
        <rect x="46" y="43" width="18" height="4" rx="2" fill="#818CF8" />
        <rect x="46" y="53" width="28" height="3.5" rx="1.75" fill="#CBD5E1" />
        <rect x="46" y="61" width="24" height="3.5" rx="1.75" fill="#CBD5E1" />
        <rect x="46" y="69" width="26" height="3.5" rx="1.75" fill="#E2E8F0" />
        <!-- Kilau Bintang AI -->
        <path d="M92 26L94.2 32.8L101 35L94.2 37.2L92 44L89.8 37.2L83 35L89.8 32.8L92 26Z" fill="#4F46E5" />
      </svg>
    </div>

    <div class="space-y-1.5">
      <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#111827]">AI sedang menganalisis jurnal...</h2>
      <p class="text-xs sm:text-sm text-slate-500">Mohon tunggu, proses analisis sedang berlangsung.</p>
    </div>

    <!-- Daftar 4 Tahapan Progres dengan Garis Penghubung -->
    <div class="max-w-xs mx-auto text-left relative py-2">
      <div class="absolute left-[11px] top-6 bottom-6 w-px bg-slate-200"></div>

      <div class="space-y-4 relative">
        <div id="step-1" class="flex items-center gap-3.5 text-sm font-semibold text-[#111827]">
          <span class="step-icon w-6 h-6 rounded-full bg-indigo-100 text-[#5B5CE6] inline-flex items-center justify-center text-[10px] font-bold shrink-0 ring-4 ring-white">&#9679;</span>
          <span>Mengunggah dokumen</span>
        </div>
        <div id="step-2" class="flex items-center gap-3.5 text-sm text-slate-400">
          <span class="step-icon w-6 h-6 rounded-full bg-slate-100 inline-flex items-center justify-center text-xs shrink-0 ring-4 ring-white"></span>
          <span>Membaca isi jurnal</span>
        </div>
        <div id="step-3" class="flex items-center gap-3.5 text-sm text-slate-400">
          <span class="step-icon w-6 h-6 rounded-full bg-slate-100 inline-flex items-center justify-center text-xs shrink-0 ring-4 ring-white"></span>
          <span>Mengidentifikasi research gap</span>
        </div>
        <div id="step-4" class="flex items-center gap-3.5 text-sm text-slate-400">
          <span class="step-icon w-6 h-6 rounded-full bg-slate-100 inline-flex items-center justify-center text-xs shrink-0 ring-4 ring-white"></span>
          <span>Menyusun rekomendasi judul</span>
        </div>
      </div>
    </div>

    <!-- Kapsul Estimasi Waktu -->
    <div class="pt-1">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-50 border border-slate-200/80 text-xs text-slate-500">
        <svg class="w-3.5 h-3.5 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" />
          <polyline points="12 6 12 12 16 14" />
        </svg>
        <span>Estimasi waktu normal 15–30 detik. Batas waktu pemrosesan 180 detik (3 menit).</span>
      </div>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- BAGIAN 3: PANEL GALAT API                                             -->
  <!-- ===================================================================== -->
  <section id="error-section" class="hidden no-print max-w-3xl w-full mx-auto bg-white rounded-3xl border border-rose-200 shadow-xs p-8 text-center space-y-4">
    <div class="mx-auto w-12 h-12 rounded-full bg-rose-50 text-rose-600 font-bold text-lg flex items-center justify-center">
      !
    </div>
    <div class="space-y-1.5">
      <h3 class="font-serif text-2xl font-bold text-[#111827]">Analisis Tidak Dapat Diselesaikan</h3>
      <p id="error-message" class="text-sm text-slate-600 max-w-md mx-auto"></p>
      <p id="error-code" class="text-xs font-mono text-rose-500 pt-1"></p>
    </div>
    <div class="pt-2">
      <button
        type="button"
        id="btn-reset-error"
        class="px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold bg-[#111827] text-white hover:bg-slate-800 transition cursor-pointer"
      >
        Kembali &amp; Perbaiki Berkas
      </button>
    </div>
  </section>

  <!-- ===================================================================== -->
  <!-- BAGIAN 4: DASBOR HASIL ANALISIS (Sidebar + Konten Utama)              -->
  <!-- ===================================================================== -->
  <section id="results-section" class="hidden w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Sidebar Navigasi Kiri -->
      <aside class="no-print lg:col-span-3 bg-white rounded-2xl border border-slate-200/90 shadow-2xs p-3 space-y-1 lg:sticky lg:top-20">
        <button
          type="button"
          data-tab="ringkasan"
          class="result-tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-left text-xs sm:text-sm font-semibold bg-[#EEF0FF] text-[#4F46E5] transition cursor-pointer"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" />
            <line x1="3" y1="9" x2="21" y2="9" />
            <line x1="9" y1="21" x2="9" y2="9" />
          </svg>
          <span>Ringkasan Literatur</span>
        </button>

        <button
          type="button"
          data-tab="gap"
          class="result-tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-left text-xs sm:text-sm font-medium text-slate-600 hover:bg-slate-50 transition cursor-pointer"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18h6" />
            <path d="M10 22h4" />
            <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14" />
          </svg>
          <span>Research Gap</span>
        </button>

        <button
          type="button"
          data-tab="sintesis"
          class="result-tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-left text-xs sm:text-sm font-medium text-slate-600 hover:bg-slate-50 transition cursor-pointer"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
          </svg>
          <span>Sintesis Research Gap</span>
        </button>

        <button
          type="button"
          data-tab="judul"
          class="result-tab-btn w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-left text-xs sm:text-sm font-medium text-slate-600 hover:bg-slate-50 transition cursor-pointer"
        >
          <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
          </svg>
          <span>Rekomendasi Judul</span>
        </button>

        <div class="pt-2 mt-2 border-t border-slate-100">
          <button
            type="button"
            id="btn-new-analysis"
            class="w-full flex items-center gap-2.5 px-3.5 py-2 rounded-xl text-left text-xs font-medium text-slate-500 hover:text-[#111827] hover:bg-slate-50 transition cursor-pointer"
          >
            <span>&larr;</span>
            <span>Analisis Dokumen Baru</span>
          </button>
        </div>
      </aside>

      <!-- Panel Konten Kanan -->
      <div class="lg:col-span-9 space-y-6">
        <div class="no-print flex flex-wrap items-center justify-between gap-2">
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#5B5CE6]">
            <span>&#10022;</span>
            <span>Hasil Analisis</span>
          </span>
          <span id="meta-info" class="text-xs text-slate-500"></span>
        </div>

        <!-- TAB 1: Ringkasan Literatur + Preview Research Gap -->
        <div id="tab-ringkasan" class="result-tab-panel print-tab-panel space-y-5">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#111827]">Ringkasan Literatur</h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">Perbandingan singkat dari jurnal yang Anda unggah.</p>
          </div>

          <div class="print-card bg-white rounded-2xl border border-slate-200/90 shadow-2xs overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse text-xs sm:text-sm">
                <thead>
                  <tr class="bg-slate-50/90 border-b border-slate-200 text-slate-700 font-semibold">
                    <th class="py-3.5 px-4 w-12 text-center">No</th>
                    <th class="py-3.5 px-4 w-1/5">Judul Jurnal</th>
                    <th class="py-3.5 px-4 w-1/6">Metode</th>
                    <th class="py-3.5 px-4 w-1/4">Temuan Utama</th>
                    <th class="py-3.5 px-4 w-1/4">Keterbatasan</th>
                  </tr>
                </thead>
                <tbody id="matrix-tbody" class="divide-y divide-slate-100"></tbody>
              </table>
            </div>
          </div>

          <!-- Kartu Pratinjau Research Gap di Bawah Tabel -->
          <div class="no-print bg-white rounded-2xl border border-slate-200/90 shadow-2xs p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-full bg-indigo-50 text-[#5B5CE6] flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M9 18h6" />
                  <path d="M10 22h4" />
                  <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14" />
                </svg>
              </div>
              <div class="space-y-1">
                <h3 class="text-sm font-bold text-[#111827]">Research Gap</h3>
                <p id="gap-preview-snippet" class="text-xs sm:text-sm text-slate-600 line-clamp-2 leading-relaxed"></p>
              </div>
            </div>
            <button
              type="button"
              id="btn-goto-gap"
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-[#111827] hover:text-[#5B5CE6] transition shrink-0 cursor-pointer"
            >
              <span>Lihat Detail</span>
              <span aria-hidden="true">&rarr;</span>
            </button>
          </div>
        </div>

        <!-- TAB 2: Peta Research Gap Teridentifikasi -->
        <div id="tab-gap" class="hidden result-tab-panel print-tab-panel space-y-5">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#111827]">Research Gap</h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">Celah penelitian spesifik yang ditautkan langsung ke dokumen sumber.</p>
          </div>
          <div id="gap-list" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
        </div>

        <!-- TAB 3: Narasi Sintesis Research Gap -->
        <div id="tab-sintesis" class="hidden result-tab-panel print-tab-panel space-y-5">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#111827]">Sintesis Research Gap</h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">Narasi komprehensif yang menghubungkan temuan dan keterbatasan antar-literatur.</p>
          </div>
          <div class="print-card bg-white rounded-2xl border border-slate-200/90 shadow-2xs p-6 sm:p-8">
            <p id="paragraf-gap" class="text-sm sm:text-base text-slate-700 leading-relaxed text-justify"></p>
          </div>
        </div>

        <!-- TAB 4: Rekomendasi Judul Penelitian Baru -->
        <div id="tab-judul" class="hidden result-tab-panel print-tab-panel space-y-5">
          <div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-[#111827]">Rekomendasi Judul</h2>
            <p class="text-xs sm:text-sm text-slate-500 mt-1">Usulan judul penelitian baru berdasarkan celah literatur yang teridentifikasi.</p>
          </div>
          <div id="judul-list" class="space-y-4"></div>
        </div>

        <!-- Catatan Verifikasi Akademik -->
        <div class="print-card bg-amber-50/80 border border-amber-200/80 rounded-2xl px-4 py-3 text-xs text-amber-900">
          <strong>Catatan Verifikasi:</strong> <span id="catatan-verifikasi"></span>
        </div>

        <!-- Bilah Tombol Ekspor Bawah -->
        <div class="no-print pt-2 flex flex-wrap items-center justify-center sm:justify-start gap-3">
          <button
            type="button"
            id="btn-copy"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-[#111827] text-white hover:bg-slate-800 transition shadow-2xs cursor-pointer"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2" />
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
            <span>Salin Semua Hasil</span>
          </button>

          <button
            type="button"
            id="btn-print"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-white text-slate-800 border border-slate-200 hover:bg-slate-50 transition shadow-2xs cursor-pointer"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 6 2 18 2 18 9" />
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
              <rect x="6" y="14" width="12" height="8" />
            </svg>
            <span>Cetak / Simpan PDF</span>
          </button>
        </div>
      </div>
    </div>
  </section>
</main>

<div
  id="app-config"
  data-max-files="<%= maxFiles %>"
  data-max-total-mb="<%= maxTotalMb %>"
  class="hidden"
></div>

<script>
  const configEl = document.getElementById('app-config');
  window.APP_CONFIG = {
    maxFiles: Number(configEl.dataset.maxFiles) || 10,
    maxTotalMb: Number(configEl.dataset.maxTotalMb) || 15
  };
</script>
<script src="/js/app.js"></script>

<%- include('partials/footer') %>